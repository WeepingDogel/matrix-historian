# Matrix Bot Configuration
MATRIX_HOMESERVER=https://matrix.org
MATRIX_USER=@yourbot:matrix.org
MATRIX_PASSWORD=your_bot_password
MATRIX_ENCRYPTION_ENABLED=false
MATRIX_DEVICE_NAME=matrix-historian

# Database Configuration (PostgreSQL)
POSTGRES_DB=historian
POSTGRES_USER=historian
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://historian:your_postgres_password_here@db:5432/historian  # pragma: allowlist secret

# Read Replica Databases (optional, comma-separated for read/write splitting)
# REPLICA_DATABASE_URLS=postgresql://user:pass@replica1:5432/historian,postgresql://user:pass@replica2:5432/historian  # pragma: allowlist secret

# API Configuration
API_PORT=8500

# MinIO Configuration (Media Storage)
MINIO_ROOT_USER=historian
MINIO_ROOT_PASSWORD=historian123
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=matrix-media
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_URL=https://minio.weepingdogel.vip

# AI Analysis (Optional)
GROQ_API_KEY=your_groq_api_key_here

# Bot → API Cache Invalidation (optional, for real-time cache refresh)
# Set this to the API service URL so the bot can notify it when data is written
# API_CACHE_INVALIDATE_URL=http://api:8500/api/v1/cache/invalidate
